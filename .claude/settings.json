{
  "permissions": {
    "deny": [
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(**/.env)",
      "Read(**/.env.*)",
      "Read(**/*.pem)",
      "Read(**/*.key)",
      "Read(**/*.jks)",
      "Read(**/*.keystore)",
      "Read(**/*.p12)",
      "Read(**/*.pfx)",
      "Read(**/service-account*.json)",
      "Read(**/*credentials*.json)",
      "Read(**/google-services.json)",
      "Read(**/GoogleService-Info.plist)",
      "Edit(**/.env)",
      "Edit(**/.env.*)",
      "Edit(**/*.pem)",
      "Edit(**/*.key)",
      "Edit(**/*.jks)",
      "Edit(**/*.keystore)",
      "Edit(**/*.p12)",
      "Edit(**/*.pfx)",
      "Edit(**/service-account*.json)",
      "Edit(**/*credentials*.json)",
      "Edit(**/google-services.json)",
      "Edit(**/GoogleService-Info.plist)",
      "Edit(./backend/alembic/versions/*)",
      "Edit(./backend/uv.lock)"
    ],
    "allow": [
      "Bash(uv run *)",
      "Bash(uv sync*)",
      "Bash(uv lock*)",
      "Bash(uv add *)",
      "Bash(make *)",
      "Bash(docker compose *)",
      "Bash(git status)",
      "Bash(git diff *)",
      "Bash(git log *)",
      "Bash(git branch*)",
      "Bash(git show *)",
      "Bash(gh pr *)",
      "Bash(gh run *)",
      "WebFetch(domain:api.github.com)",
      "WebFetch(domain:github.com)",
      "WebFetch(domain:files.pythonhosted.org)",
      "WebFetch(domain:pypi.org)",
      "WebFetch(domain:fastapi.tiangolo.com)",
      "WebFetch(domain:docs.sqlalchemy.org)",
      "WebFetch(domain:docs.pydantic.dev)"
    ],
    "ask": [
      "Bash(rm -rf *)",
      "Bash(git push --force *)",
      "Bash(git push -f *)",
      "Bash(docker compose down -v*)",
      "Bash(uv run alembic downgrade *)",
      "Bash(gcloud *)",
      "Bash(firebase deploy*)",
      "Bash(terraform apply *)",
      "Bash(terraform destroy *)"
    ]
  },
  "sandbox": {
    "enabled": true,
    "autoAllowBashIfSandboxed": true,
    "excludedCommands": [
      "gh *",
      "gcloud *",
      "docker *",
      "open *",
      "osascript *"
    ],
    "network": {
      "allowedDomains": [
        "api.github.com",
        "github.com",
        "files.pythonhosted.org",
        "pypi.org",
        "registry.npmjs.org",
        "generativelanguage.googleapis.com",
        "aiplatform.googleapis.com",
        "oauth2.googleapis.com",
        "www.googleapis.com",
        "securetoken.google.com",
        "pub.dev",
        "storage.googleapis.com"
      ]
    }
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Write",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PROJECT_DIR:-$PWD}/.claude/hooks/inject-rules.py\" || true"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "f=\"${CLAUDE_PROJECT_DIR:-$PWD}/.claude/hooks/post-edit-check.py\"; if [ -f \"$f\" ]; then python3 \"$f\"; fi",
            "timeout": 120
          }
        ]
      }
    ]
  },
  "env": {
    "UV_LINK_MODE": "copy"
  }
}
