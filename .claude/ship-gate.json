{
  "version": 1,
  "_note": "Definition of Done, in two parts. The `py.*` commands are exactly the steps of `cd backend && make gate` and the jobs of .github/workflows/backend-ci.yaml. The `infra.*` commands run from the repository root (there is no root Makefile) and are exactly the delivery-scripts job of .github/workflows/infra-ci.yaml and the matching pre-commit hooks. Change one, change its pair (.claude/rules/ci-conventions.md \u00a75). `infra.shell-lint` is here because it was not, and the two halves drifted: CI ran shellcheck over the test scripts as well as the deploy script while this file listed neither, so a finding in a test script passed every local check and failed on a runner. The scope below is the workflow step verbatim. Flutter gate lands with GGU-1.",
  "required": [
    {
      "id": "py.lint",
      "cwd": "backend",
      "cmd": "uv run ruff check ."
    },
    {
      "id": "py.format",
      "cwd": "backend",
      "cmd": "uv run ruff format --check ."
    },
    {
      "id": "py.types",
      "cwd": "backend",
      "cmd": "uv run basedpyright"
    },
    {
      "id": "py.budget",
      "cwd": "backend",
      "cmd": "uv run python scripts/check_file_budget.py"
    },
    {
      "id": "py.catalog",
      "cwd": "backend",
      "cmd": "uv run python scripts/generate_catalog_contract.py --check"
    },
    {
      "id": "py.quality",
      "cwd": "backend",
      "cmd": "make quality"
    },
    {
      "id": "py.test",
      "cwd": "backend",
      "cmd": "uv run pytest --cov --cov-branch --cov-report=term-missing --cov-report=xml"
    },
    {
      "id": "py.audit",
      "cwd": "backend",
      "cmd": "make audit"
    },
    {
      "id": "infra.shell-lint",
      "cwd": ".",
      "cmd": "shellcheck infra/scripts/deploy_cloud_run.sh infra/scripts/tests/*.sh"
    },
    {
      "id": "infra.delivery-script",
      "cwd": ".",
      "cmd": "bash infra/scripts/tests/test_deploy_cloud_run.sh"
    },
    {
      "id": "infra.credential-model",
      "cwd": ".",
      "cmd": "bash infra/scripts/tests/test_wif_conditions.sh"
    },
    {
      "id": "infra.dev-environment",
      "cwd": ".",
      "cmd": "bash infra/scripts/tests/test_dev_environment.sh"
    },
    {
      "id": "infra.rules-index",
      "cwd": ".",
      "cmd": "bash infra/scripts/tests/test_rules_index.sh"
    },
    {
      "id": "infra.rate-limit-ceiling",
      "cwd": ".",
      "cmd": "bash infra/scripts/tests/test_rate_limit_ceiling.sh"
    }
  ],
  "_candidates": [
    {
      "id": "dart.format",
      "cwd": "client_flutter",
      "cmd": "dart format --output=none --set-exit-if-changed ."
    },
    {
      "id": "dart.analyze",
      "cwd": "client_flutter",
      "cmd": "dart analyze --fatal-infos --fatal-warnings"
    },
    {
      "id": "flutter.test",
      "cwd": "client_flutter/app",
      "cmd": "flutter test --coverage"
    },
    {
      "id": "flutter.web",
      "cwd": "client_flutter/app",
      "cmd": "flutter build web --release"
    }
  ]
}
