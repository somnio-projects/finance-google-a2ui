[
  {
    "beginRendering": {
      "surfaceId": "order-confirmation",
      "root": "confirmation-card",
      "styles": {
        "primaryColor": "#FF0000",
        "font": "Roboto"
      }
    }
  },
  {
    "surfaceUpdate": {
      "surfaceId": "order-confirmation",
      "components": [
        {
          "id": "confirmation-card",
          "component": {
            "Card": {
              "child": "confirmation-column"
            }
          }
        },
        {
          "id": "confirmation-column",
          "component": {
            "Column": {
              "children": {
                "explicitList": [
                  "confirm-title",
                  "confirm-logo",
                  "divider1",
                  "confirm-amount",
                  "confirm-quantity",
                  "divider2",
                  "confirm-note"
                ]
              }
            }
          }
        },
        {
          "id": "confirm-title",
          "component": {
            "Text": {
              "usageHint": "h2",
              "text": {
                "path": "/title"
              }
            }
          }
        },
        {
          "id": "confirm-logo",
          "component": {
            "Image": {
              "usageHint": "avatar",
              "url": {
                "path": "/logoUrl"
              }
            }
          }
        },
        {
          "id": "confirm-amount",
          "component": {
            "Text": {
              "text": {
                "path": "/amountDetails"
              }
            }
          }
        },
        {
          "id": "confirm-quantity",
          "component": {
            "Text": {
              "text": {
                "path": "/quantityDetails"
              }
            }
          }
        },
        {
          "id": "confirm-note",
          "component": {
            "Text": {
              "usageHint": "caption",
              "text": {
                "literalString": "Simulated order. No real funds were used."
              }
            }
          }
        },
        {
          "id": "divider1",
          "component": {
            "Divider": {}
          }
        },
        {
          "id": "divider2",
          "component": {
            "Divider": {}
          }
        }
      ]
    }
  },
  {
    "dataModelUpdate": {
      "surfaceId": "order-confirmation",
      "path": "/",
      "contents": [
        { "key": "title", "valueString": "Order placed: [Name]" },
        {
          "key": "amountDetails",
          "valueString": "Bought [AmountDisplay] of [Symbol] at [PriceDisplay]"
        },
        {
          "key": "quantityDetails",
          "valueString": "Quantity: [Quantity] [Symbol]"
        },
        { "key": "logoUrl", "valueString": "[LogoURL]" }
      ]
    }
  }
]
