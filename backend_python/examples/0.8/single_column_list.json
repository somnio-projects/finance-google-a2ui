[
  {
    "beginRendering": {
      "surfaceId": "default",
      "root": "root-column",
      "styles": {
        "primaryColor": "#FF0000",
        "font": "Roboto"
      }
    }
  },
  {
    "surfaceUpdate": {
      "surfaceId": "default",
      "components": [
        {
          "id": "root-column",
          "component": {
            "Column": {
              "children": {
                "explicitList": ["title-heading", "item-list"]
              }
            }
          }
        },
        {
          "id": "title-heading",
          "component": {
            "Text": {
              "usageHint": "h1",
              "text": {
                "path": "/title"
              }
            }
          }
        },
        {
          "id": "item-list",
          "component": {
            "List": {
              "direction": "vertical",
              "children": {
                "template": {
                  "componentId": "item-card-template",
                  "dataBinding": "/items"
                }
              }
            }
          }
        },
        {
          "id": "item-card-template",
          "component": {
            "Card": {
              "child": "card-layout"
            }
          }
        },
        {
          "id": "card-layout",
          "component": {
            "Row": {
              "children": {
                "explicitList": ["template-logo", "card-details"]
              }
            }
          }
        },
        {
          "id": "template-logo",
          "component": {
            "Image": {
              "usageHint": "avatar",
              "url": {
                "path": "/logoUrl"
              }
            }
          }
        },
        {
          "id": "card-details",
          "weight": 1,
          "component": {
            "Column": {
              "children": {
                "explicitList": [
                  "template-name",
                  "template-symbol",
                  "template-price-row",
                  "template-market-cap-row",
                  "template-detail",
                  "template-buy-button"
                ]
              }
            }
          }
        },
        {
          "id": "template-name",
          "component": {
            "Text": {
              "usageHint": "h3",
              "text": {
                "path": "/name"
              }
            }
          }
        },
        {
          "id": "template-symbol",
          "component": {
            "Text": {
              "usageHint": "caption",
              "text": {
                "path": "/symbol"
              }
            }
          }
        },
        {
          "id": "template-price-row",
          "component": {
            "Row": {
              "children": {
                "explicitList": ["template-price", "template-change"]
              }
            }
          }
        },
        {
          "id": "template-price",
          "component": {
            "Text": {
              "usageHint": "h4",
              "text": {
                "path": "/priceDisplay"
              }
            }
          }
        },
        {
          "id": "template-change",
          "component": {
            "Text": {
              "text": {
                "path": "/change24hDisplay"
              }
            }
          }
        },
        {
          "id": "template-market-cap-row",
          "component": {
            "Row": {
              "children": {
                "explicitList": [
                  "template-market-cap-label",
                  "template-market-cap"
                ]
              }
            }
          }
        },
        {
          "id": "template-market-cap-label",
          "component": {
            "Text": {
              "usageHint": "caption",
              "text": {
                "literalString": "Market cap"
              }
            }
          }
        },
        {
          "id": "template-market-cap",
          "component": {
            "Text": {
              "usageHint": "caption",
              "text": {
                "path": "/marketCapDisplay"
              }
            }
          }
        },
        {
          "id": "template-detail",
          "component": {
            "Text": {
              "text": {
                "path": "/detail"
              }
            }
          }
        },
        {
          "id": "template-buy-button",
          "component": {
            "Button": {
              "child": "buy-text",
              "primary": true,
              "action": {
                "name": "buy_asset",
                "context": [
                  {
                    "key": "symbol",
                    "value": {
                      "path": "/symbol"
                    }
                  }
                ]
              }
            }
          }
        },
        {
          "id": "buy-text",
          "component": {
            "Text": {
              "text": {
                "literalString": "Buy"
              }
            }
          }
        }
      ]
    }
  },
  {
    "dataModelUpdate": {
      "surfaceId": "default",
      "path": "/",
      "contents": [
        {
          "key": "title",
          "valueString": "Top Cryptocurrencies"
        },
        {
          "key": "items",
          "valueMap": [
            {
              "key": "item1",
              "valueMap": [
                { "key": "symbol", "valueString": "AAA" },
                { "key": "name", "valueString": "Example Coin" },
                { "key": "price", "valueNumber": 1234.5 },
                { "key": "priceDisplay", "valueString": "$1,234.50" },
                { "key": "change24hPct", "valueNumber": 1.25 },
                { "key": "change24hDisplay", "valueString": "+1.25%" },
                { "key": "trend", "valueString": "up" },
                { "key": "marketCapDisplay", "valueString": "$12.30B" },
                { "key": "detail", "valueString": "An example layer 1 blockchain." },
                { "key": "logoUrl", "valueString": "https://example.com/aaa.png" }
              ]
            },
            {
              "key": "item2",
              "valueMap": [
                { "key": "symbol", "valueString": "BBB" },
                { "key": "name", "valueString": "Sample Token" },
                { "key": "price", "valueNumber": 0.4321 },
                { "key": "priceDisplay", "valueString": "$0.4321" },
                { "key": "change24hPct", "valueNumber": -2.5 },
                { "key": "change24hDisplay", "valueString": "-2.50%" },
                { "key": "trend", "valueString": "down" },
                { "key": "marketCapDisplay", "valueString": "$850.00M" },
                { "key": "detail", "valueString": "An example DeFi token." },
                { "key": "logoUrl", "valueString": "https://example.com/bbb.png" }
              ]
            }
          ]
        }
      ]
    }
  }
]
