[
  {
    "version": "v0.9",
    "createSurface": {
      "surfaceId": "order-form",
      "catalogId": "https://a2ui.org/specification/v0_9/catalogs/basic/catalog.json",
      "theme": {
        "primaryColor": "#FF0000",
        "font": "Roboto"
      }
    }
  },
  {
    "version": "v0.9",
    "updateComponents": {
      "surfaceId": "order-form",
      "components": [
        {
          "id": "root",
          "component": "Column",
          "children": [
            "order-title",
            "order-header",
            "order-hint",
            "amount-field",
            "submit-button"
          ]
        },
        {
          "id": "order-title",
          "component": "Text",
          "variant": "h2",
          "text": {
            "path": "/title"
          }
        },
        {
          "id": "order-header",
          "component": "Row",
          "align": "center",
          "children": ["order-logo", "order-asset"]
        },
        {
          "id": "order-logo",
          "component": "Image",
          "variant": "avatar",
          "url": {
            "path": "/logoUrl"
          }
        },
        {
          "id": "order-asset",
          "component": "Column",
          "children": ["order-name", "order-price"]
        },
        {
          "id": "order-name",
          "component": "Text",
          "variant": "h3",
          "text": {
            "path": "/assetLabel"
          }
        },
        {
          "id": "order-price",
          "component": "Text",
          "text": {
            "path": "/priceDisplay"
          }
        },
        {
          "id": "order-hint",
          "component": "Text",
          "variant": "caption",
          "text": {
            "path": "/hint"
          }
        },
        {
          "id": "amount-field",
          "component": "TextField",
          "label": "Amount (USD)",
          "value": {
            "path": "/amountUsd"
          },
          "variant": "number"
        },
        {
          "id": "submit-button",
          "component": "Button",
          "child": "submit-order-text",
          "variant": "primary",
          "action": {
            "event": {
              "name": "submit_order",
              "context": {
                "symbol": {
                  "path": "/symbol"
                },
                "amountUsd": {
                  "path": "/amountUsd"
                }
              }
            }
          }
        },
        {
          "id": "submit-order-text",
          "component": "Text",
          "text": "Place Order"
        }
      ]
    }
  },
  {
    "version": "v0.9",
    "updateDataModel": {
      "surfaceId": "order-form",
      "path": "/",
      "value": {
        "title": "Buy [Name]",
        "assetLabel": "[Name] ([Symbol])",
        "priceDisplay": "[PriceDisplay]",
        "hint": "[Hint]",
        "symbol": "[Symbol]",
        "logoUrl": "[LogoURL]",
        "amountUsd": "100"
      }
    }
  }
]
