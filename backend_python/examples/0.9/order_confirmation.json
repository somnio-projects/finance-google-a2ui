[
  {
    "version": "v0.9",
    "createSurface": {
      "surfaceId": "order-confirmation",
      "catalogId": "https://a2ui.org/specification/v0_9/catalogs/basic/catalog.json",
      "theme": {
        "primaryColor": "#FF0000",
        "font": "Roboto"
      }
    }
  },
  {
    "version": "v0.9",
    "updateComponents": {
      "surfaceId": "order-confirmation",
      "components": [
        {
          "id": "root",
          "component": "Card",
          "child": "confirmation-column"
        },
        {
          "id": "confirmation-column",
          "component": "Column",
          "children": [
            "confirm-title",
            "confirm-logo",
            "divider1",
            "confirm-amount",
            "confirm-quantity",
            "divider2",
            "confirm-note"
          ]
        },
        {
          "id": "confirm-title",
          "component": "Text",
          "variant": "h2",
          "text": {
            "path": "/title"
          }
        },
        {
          "id": "confirm-logo",
          "component": "Image",
          "variant": "avatar",
          "url": {
            "path": "/logoUrl"
          }
        },
        {
          "id": "confirm-amount",
          "component": "Text",
          "text": {
            "path": "/amountDetails"
          }
        },
        {
          "id": "confirm-quantity",
          "component": "Text",
          "text": {
            "path": "/quantityDetails"
          }
        },
        {
          "id": "confirm-note",
          "component": "Text",
          "variant": "caption",
          "text": "Simulated order. No real funds were used."
        },
        {
          "id": "divider1",
          "component": "Divider"
        },
        {
          "id": "divider2",
          "component": "Divider"
        }
      ]
    }
  },
  {
    "version": "v0.9",
    "updateDataModel": {
      "surfaceId": "order-confirmation",
      "path": "/",
      "value": {
        "title": "Order placed: [Name]",
        "amountDetails": "Bought [AmountDisplay] of [Symbol] at [PriceDisplay]",
        "quantityDetails": "Quantity: [Quantity] [Symbol]",
        "logoUrl": "[LogoURL]"
      }
    }
  }
]
