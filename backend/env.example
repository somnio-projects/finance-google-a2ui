# Copy to `.env` for local runs (`cp env.example .env`). NEVER commit `.env`.
# `docker compose` (repo root) loads this file too via `env_file` and overrides
# only the topology keys (DATABASE_URL, PUBLIC_BASE_URL, CORS_ALLOWED_ORIGINS,
# UVICORN_EXTRA_ARGS) — everything else, credentials included, comes from here.
# Every value here is a placeholder; production values come from Secret Manager (ADR-G).
# The file is named without a leading dot on purpose: the repo's Claude Code
# permissions deny any tool from touching `**/.env.*`, templates included.

# --- runtime ---------------------------------------------------------------
ENVIRONMENT=local                  # local | test | dev | staging | production
LOG_LEVEL=INFO
PUBLIC_BASE_URL=http://localhost:8000
APP_RELEASE=                       # set by the CD pipeline to <version>+<short sha>; blank -> packaged version on /healthz

# --- database (asyncpg driver) ---------------------------------------------
DATABASE_URL=postgresql+asyncpg://app:app@localhost:5432/finance
DATABASE_POOL_SIZE=5
DATABASE_ECHO=false

# --- http hardening ---------------------------------------------------------
CORS_ALLOWED_ORIGINS=http://localhost:3000   # comma separated; empty = none
TRUSTED_HOSTS=*                              # comma separated Host allow-list
MAX_REQUEST_BODY_BYTES=1048576
RATE_LIMIT_PER_MINUTE=120

# --- feature flags (spec 0002) ---------------------------------------------
FEATURE_FLAGS_CACHE_TTL_SECONDS=15
# FEATURE_FLAGS_FORCE_DISABLED=identity.audit   # comma separated kill-switch, wins over the DB

# --- authentication ---------------------------------------------------------
# AUTH_PROVIDER=jwt  -> HS256 with AUTH_JWT_SECRET (dev / service-to-service)
# AUTH_PROVIDER=oidc -> RS256 against AUTH_OIDC_JWKS_URL (Firebase, Google, SSO)
AUTH_PROVIDER=jwt
AUTH_ISSUER=https://issuer.example
AUTH_AUDIENCE=finance-a2ui
AUTH_JWT_SECRET=change-me-to-a-long-random-value
# AUTH_OIDC_JWKS_URL=https://www.googleapis.com/service_accounts/v1/jwk/securetoken@system.gserviceaccount.com
AUTH_LEEWAY_SECONDS=30
# Provisioning (spec 0027). Sign-in is invite-only: these e-mails become active
# admins at boot (idempotent) so the registry can be managed from the API.
# AUTH_BOOTSTRAP_ADMINS=you@company.com
# The design's "Continue with email" on a stack with no Firebase: mints the
# same HS256 token `make token` does, for provisioned e-mails only. Honoured
# only under AUTH_PROVIDER=jwt; every deployed stack runs oidc and 404s it.
# AUTH_PREVIEW_SIGN_IN_ENABLED=false
# AUTH_PREVIEW_TOKEN_TTL_SECONDS=28800
# AUTH_ADMIN_REQUIRE_MFA=true   # unset = required only when ENVIRONMENT=production; admin tokens need an MFA `amr`

# --- agent host (spec 0006) -------------------------------------------------
# Unset GEMINI_API_KEY = the deterministic ScriptedModelClient (spec 0033): the
# service boots and replays the demo's flows from a table, exactly as an unset
# SENTRY_DSN means the null reporter. A prompt outside the table is answered
# with the honest "no model provider" sentence; nothing is invented.
# Production value comes from Secret Manager (ADR-G) — never from this file.
# GEMINI_API_KEY=change-me-to-the-provider-key
GEMINI_MODEL=gemini-3.8-flash      # ADR-D D-4; nothing in the code depends on the id
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta
GEMINI_TIMEOUT_SECONDS=60.0        # per HTTP attempt, 1.0-120.0. A turn spends
                                   # 2-3 calls and measured 10-46s end to end;
                                   # 20 was below that (spec backend/0036).
GEMINI_MAX_ATTEMPTS=3              # 1-5; only transport errors and 408/429/5xx are retried
AGENT_MAX_TOOL_ITERATIONS=4        # 1-10; model calls per turn, not tool calls

# --- data retention (docs/compliance/DATA_RETENTION.md) ---------------------
AUDIT_RETENTION_DAYS=400           # `make purge-audit` deletes audit_events older than this

# --- observability ----------------------------------------------------------
# SENTRY_DSN=                        # unset = telemetry disabled (no-op reporter)
SENTRY_TRACES_SAMPLE_RATE=0.0
