# Copy this file to .env and fill in your API key
# Get your API key at: https://aistudio.google.com/apikey

GEMINI_API_KEY=your_gemini_api_key_here

# Optional: Use Vertex AI instead of Gemini API
# GOOGLE_GENAI_USE_VERTEXAI=TRUE

# Optional: override the model. Takes priority over LITELLM_MODEL.
# Default when unset: gemini-3.8-flash
# MODEL_NAME=gemini-2.5-flash

# Optional: use a non-Gemini model through LiteLLM by adding a provider prefix.
# Requires the matching provider key below.
# MODEL_NAME=anthropic/claude-sonnet-5
# ANTHROPIC_API_KEY=sk-ant-...
# OPENAI_API_KEY=sk-...

# Optional: disable streaming (useful when testing a new provider).
# USE_STREAMING=false
