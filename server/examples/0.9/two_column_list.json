            "event": {
              "name": "buy_asset",
              "context": {
                "symbol": {
                  "path": "1/symbol"
                }
              }
            }
          }
        },
        {
          "id": "buy-text-right",
          "component": "Text",
          "text": "Buy"
        }
      ]
    }
