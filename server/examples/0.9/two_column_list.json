[
  {
    "version": "v0.9",
    "createSurface": {
      "surfaceId": "default",
      "catalogId": "https://a2ui.org/specification/v0_9/catalogs/basic/catalog.json",
      "theme": {
        "primaryColor": "#FF0000",
        "font": "Roboto"
      }
    }
  },
  {
    "version": "v0.9",
    "updateComponents": {
      "surfaceId": "default",
      "components": [
        {
          "id": "root",
          "component": "Column",
          "children": ["title-heading", "asset-list"]
        },
        {
          "id": "title-heading",
          "component": "Text",
          "variant": "h1",
          "text": {
            "path": "/title"
          }
        },
        {
          "id": "asset-list",
          "component": "List",
          "direction": "vertical",
          "children": {
            "componentId": "row-template",
            "path": "/items"
          }
        },
        {
          "id": "row-template",
          "component": "Row",
          "children": ["card-template-left", "card-template-right"]
        },
        {
          "id": "card-template-left",
          "component": "Card",
          "weight": 1,
          "child": "card-layout-left"
        },
        {
          "id": "card-layout-left",
          "component": "Column",
          "children": [
            "template-logo-left",
            "template-name-left",
            "template-symbol-left",
            "template-price-left",
            "template-change-left",
            "template-buy-button-left"
          ]
        },
        {
          "id": "template-logo-left",
          "component": "Image",
          "variant": "avatar",
          "url": {
            "path": "0/logoUrl"
          }
        },
        {
          "id": "template-name-left",
          "component": "Text",
          "variant": "h3",
          "text": {
            "path": "0/name"
          }
        },
        {
          "id": "template-symbol-left",
          "component": "Text",
          "variant": "caption",
          "text": {
            "path": "0/symbol"
          }
        },
        {
          "id": "template-price-left",
          "component": "Text",
          "variant": "h4",
          "text": {
            "path": "0/priceDisplay"
          }
        },
        {
          "id": "template-change-left",
          "component": "Text",
          "text": {
            "path": "0/change24hDisplay"
          }
        },
        {
          "id": "template-buy-button-left",
          "component": "Button",
          "child": "buy-text-left",
          "action": {
            "event": {
              "name": "buy_asset",
              "context": {
                "symbol": {
                  "path": "0/symbol"
                }
              }
            }
          }
        },
        {
          "id": "buy-text-left",
          "component": "Text",
          "text": "Buy"
        },
        {
          "id": "card-template-right",
          "component": "Card",
          "weight": 1,
          "child": "card-layout-right"
        },
        {
          "id": "card-layout-right",
          "component": "Column",
          "children": [
            "template-logo-right",
            "template-name-right",
            "template-symbol-right",
            "template-price-right",
            "template-change-right",
            "template-buy-button-right"
          ]
        },
        {
          "id": "template-logo-right",
          "component": "Image",
          "variant": "avatar",
          "url": {
            "path": "1/logoUrl"
          }
        },
        {
          "id": "template-name-right",
          "component": "Text",
          "variant": "h3",
          "text": {
            "path": "1/name"
          }
        },
        {
          "id": "template-symbol-right",
          "component": "Text",
          "variant": "caption",
          "text": {
            "path": "1/symbol"
          }
        },
        {
          "id": "template-price-right",
          "component": "Text",
          "variant": "h4",
          "text": {
            "path": "1/priceDisplay"
          }
        },
        {
          "id": "template-change-right",
          "component": "Text",
          "text": {
            "path": "1/change24hDisplay"
          }
        },
        {
          "id": "template-buy-button-right",
          "component": "Button",
