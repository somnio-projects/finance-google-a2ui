[
  {
    "version": "v0.9",
    "createSurface": {
      "surfaceId": "default",
      "catalogId": "https://a2ui.org/specification/v0_9/catalogs/basic/catalog.json",
      "theme": {
        "primaryColor": "#FF0000",
        "font": "Roboto"
      }
    }
  },
  {
    "version": "v0.9",
    "updateComponents": {
      "surfaceId": "default",
      "components": [
        {
          "id": "root",
          "component": "Column",
          "children": ["title-heading", "item-list"]
        },
        {
          "id": "title-heading",
          "component": "Text",
          "variant": "h1",
          "text": {
            "path": "/title"
          }
        },
        {
          "id": "item-list",
          "component": "List",
          "direction": "vertical",
          "children": {
            "componentId": "item-card-template",
            "path": "/items"
          }
        },
        {
          "id": "item-card-template",
          "component": "Card",
          "child": "card-layout"
        },
        {
          "id": "card-layout",
          "component": "Row",
          "children": ["card-logo", "card-details"]
        },
        {
          "id": "card-logo",
          "component": "Image",
          "variant": "avatar",
          "url": {
            "path": "logoUrl"
          }
        },
        {
          "id": "card-details",
          "component": "Column",
          "weight": 1,
          "children": [
            "template-name",
            "template-symbol",
            "template-price-row",
            "template-market-cap-row",
            "template-detail",
            "template-buy-button"
          ]
        },
        {
          "id": "template-name",
          "component": "Text",
          "variant": "h3",
          "text": {
            "path": "name"
          }
        },
        {
          "id": "template-symbol",
          "component": "Text",
          "variant": "caption",
          "text": {
            "path": "symbol"
          }
        },
        {
          "id": "template-price-row",
          "component": "Row",
          "children": ["template-price", "template-change"]
        },
        {
          "id": "template-price",
          "component": "Text",
          "variant": "h4",
          "text": {
            "path": "priceDisplay"
          }
        },
        {
          "id": "template-change",
          "component": "Text",
          "text": {
            "path": "change24hDisplay"
          }
        },
        {
          "id": "template-market-cap-row",
          "component": "Row",
          "children": ["template-market-cap-label", "template-market-cap"]
        },
        {
          "id": "template-market-cap-label",
          "component": "Text",
          "variant": "caption",
          "text": "Market cap"
        },
        {
          "id": "template-market-cap",
          "component": "Text",
          "variant": "caption",
          "text": {
            "path": "marketCapDisplay"
          }
        },
        {
          "id": "template-detail",
          "component": "Text",
          "text": {
            "path": "detail"
          }
        },
        {
          "id": "template-buy-button",
          "component": "Button",
          "child": "buy-text",
          "variant": "primary",
          "action": {
            "event": {
              "name": "buy_asset",
              "context": {
                "symbol": {
                  "path": "symbol"
                }
              }
            }
          }
        },
        {
          "id": "buy-text",
          "component": "Text",
          "text": "Buy"
        }
      ]
    }
  },
  {
    "version": "v0.9",
    "updateDataModel": {
      "surfaceId": "default",
      "path": "/title",
      "value": "Top Cryptocurrencies"
    }
  },
  {
    "version": "v0.9",
    "updateDataModel": {
      "surfaceId": "default",
      "path": "/items",
      "value": [
        {
          "symbol": "AAA",
          "name": "Example Coin",
          "category": "Layer 1",
          "price": 1234.5,
          "priceDisplay": "$1,234.50",
          "change24hPct": 1.25,
          "change24hDisplay": "+1.25%",
          "trend": "up",
          "marketCapDisplay": "$12.30B",
          "detail": "An example layer 1 blockchain.",
          "logoUrl": "https://example.com/aaa.png"
        },
        {
          "symbol": "BBB",
          "name": "Sample Token",
          "category": "DeFi",
          "price": 0.4321,
          "priceDisplay": "$0.4321",
          "change24hPct": -2.5,
          "change24hDisplay": "-2.50%",
          "trend": "down",
          "marketCapDisplay": "$850.00M",
          "detail": "An example DeFi token.",
          "logoUrl": "https://example.com/bbb.png"
        }
      ]
    }
  }
]
