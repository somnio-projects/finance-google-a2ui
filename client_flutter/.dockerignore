# Keep the build context to what `flutter build web` actually reads.
# Anything listed here either cannot reach the final image (the runtime stage
# copies only build/web) or must never be in a build context at all.
.git
.env
.env.*
.dart_tool
build
**/.dart_tool
**/build
**/.flutter-plugins
**/.flutter-plugins-dependencies
coverage
**/coverage
.claude
.claude-flow
docs

# Other platform targets — this image serves the web build only.
app/android
app/ios
app/macos
app/linux
app/windows

# The e2e suite reads a Gemini API key from the environment; it is not part of
# the shipped bundle and has no business in the context. Its pubspec still is,
# because `resolution: workspace` will not resolve without it.
e2e_test/test
