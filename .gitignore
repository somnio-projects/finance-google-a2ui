# OS / editors
.DS_Store
.idea/
*.iml

# Secrets — env files live inside each solution (backend/.env, ...) and are never committed;
# the committed templates are named `env.example` (no leading dot).
.env
**/.env
**/.env.*

# Python
**/.venv/
**/__pycache__/
**/.ruff_cache/

# Dart / Flutter workspace
.dart_tool/
**/build/

# Logs
*.log

# Ruflo local secrets and runtime data
.env.local
.env.*.local
.claude-flow/
.swarm/
ruvector.db
ruvector.db-*

# Codex local configuration
.codex/
# Claude Flow runtime data
# Environment variables

# AI harness per-directory provenance files.
# The manifests at the repo, backend_python and client_flutter roots are
# tracked deliberately; these rules only keep the harness from adding new
# ones in every package directory it happens to touch.
**/.claude/proven-config.json
**/.claude/.proven-config-version

# somnio:harness:begin
.claude/.harness/
.claude/*.local.md
.claude/settings.json.bak
# somnio:harness:end

# Backend (Python) artifacts
backend/.coverage
backend/coverage.xml
backend/htmlcov/
backend/.pytest_cache/
backend/.env

# Somnio CLI audit reports (attached to PRs, not versioned)
backend/reports/
reports/

# Terraform working files (provider binaries, state) — never committed
infra/.terraform/
*.tfstate
*.tfstate.*
infra/.terraform.tfstate.lock.info

# Agent worktrees (Claude Code isolation)
.claude/worktrees/
