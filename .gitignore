# OS / editors
.DS_Store
.idea/
# IntelliJ module files, generated by `flutter create`
*.iml

# Secrets — env files live inside each solution (backend/.env, ...) and are never committed;
# the committed templates are named `env.example` (no leading dot).
.env
**/.env
**/.env.*

# Python
**/.venv/
**/__pycache__/
**/.ruff_cache/

# Dart / Flutter workspace
.dart_tool/
**/build/
# Coverage output from `flutter test --coverage` / `dart test --coverage`.
# The lcov reports are gate input, never committed.
frontend/app/coverage/
frontend/packages/*/coverage/

# Logs
*.log

# Ruflo local secrets and runtime data
.env.local
.env.*.local
.claude-flow/
.swarm/
ruvector.db
ruvector.db-*

# Codex local configuration
.codex/
# Claude Flow runtime data
# Environment variables

# somnio:harness:begin
.claude/.harness/
.claude/*.local.md
.claude/settings.json.bak
# somnio:harness:end

# Backend (Python) artifacts
backend/.coverage
backend/coverage.xml
backend/htmlcov/
backend/.pytest_cache/
backend/.env

# Somnio CLI audit reports (attached to PRs, not versioned)
backend/reports/
reports/

# Terraform working files (provider binaries, state) — never committed
infra/.terraform/
*.tfstate
*.tfstate.*
infra/.terraform.tfstate.lock.info

# Agent worktrees (Claude Code isolation)
.claude/worktrees/
