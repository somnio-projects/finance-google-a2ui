# OS / editors
.DS_Store
.idea/
# IntelliJ module files, generated by `flutter create`
*.iml

# Secrets — env files live inside each solution (backend/.env, ...) and are never committed;
# the committed templates are named `env.example` (no leading dot).
.env
**/.env
**/.env.*

# Python
**/.venv/
**/__pycache__/
**/.ruff_cache/

# Dart / Flutter workspace
.dart_tool/
**/build/
# Coverage output from `flutter test --coverage` / `dart test --coverage`.
# The lcov reports are gate input, never committed.
frontend/app/coverage/
frontend/packages/*/coverage/
# Golden *failure* output. `matchesGoldenFile` writes a failures/ directory
# beside the suite when a comparison fails — four PNGs per golden, including a
# byte-copy of the committed master. It is the debris of a red run, not an
# artefact: committing it leaves a permanent record of a failure that no gate
# will ever refresh. The goldens themselves are committed and gated.
**/test/**/failures/

# Logs
*.log

# Ruflo local secrets and runtime data
.env.local
.env.*.local
.claude-flow/
.swarm/
ruvector.db
ruvector.db-*

# Codex local configuration
.codex/
# Claude Flow runtime data
# Environment variables

# AI harness per-directory provenance files.
# The manifests at the repo and client_flutter roots are tracked
# deliberately; these rules only keep the harness from adding new ones in
# every package directory it happens to touch.
**/.claude/proven-config.json
**/.claude/.proven-config-version

# somnio:harness:begin
.claude/.harness/
.claude/*.local.md
.claude/settings.json.bak
# somnio:harness:end

# Backend (Python) artifacts
backend/.coverage
backend/coverage.xml
backend/htmlcov/
backend/.pytest_cache/
backend/.env

# Somnio CLI audit reports (attached to PRs, not versioned)
backend/reports/
reports/

# Terraform working files (provider binaries, state) — never committed
infra/.terraform/
*.tfstate
*.tfstate.*
infra/.terraform.tfstate.lock.info

# Agent worktrees (Claude Code isolation)
.claude/worktrees/

# Machine state that keeps arriving inside the repository, in a PUBLIC repo.
#
# `.claude/launch.json` is one editor's run configuration. Commit 5f6e09c
# committed one naming `/private/tmp/claude-501/pato/standalone` — a path on one
# laptop — and pushed it to a branch on a public remote. It never reached
# `develop` (the squash in 4189eef dropped it), which is luck rather than a
# control. It is untracked machine state and has no business being committable.
#
# `.design-refs/` is the design bundles. They only render from inside the
# project folder, so every agent doing pixel-work ends up with fourteen HTML
# files and a 69 KB support.js in its worktree.
.claude/launch.json
.design-refs/
